import { Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule, ReactiveFormsModule, FormBuilder, FormGroup, Validators } from '@angular/forms';
import { HealthService } from '../services/health.service';
import { DietPlan } from '../models/health.models';

@Component({
  selector: 'app-health-diet-plans',
  standalone: true,
  imports: [CommonModule, FormsModule, ReactiveFormsModule],
  template: `
    <div class="min-h-screen bg-gradient-to-br from-gray-900 to-gray-950 text-white p-6 font-sans">
      <div class="fixed inset-0 bg-black/40 backdrop-blur-[2px] pointer-events-none"></div>
      
      <div class="relative z-10 max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <h1 class="text-4xl font-bold bg-gradient-to-r from-blue-400 to-green-400 bg-clip-text text-transparent">
            Plans alimentaires
          </h1>
          <button (click)="openCreateModal()" 
                  class="bg-blue-500 hover:bg-blue-600 px-6 py-2 rounded-lg transition flex items-center space-x-2">
            <i class="fas fa-plus"></i>
            <span>Nouveau plan</span>
          </button>
        </div>

        <!-- Plan actif -->
        <div *ngIf="activePlan" class="bg-gradient-to-br from-blue-500/20 to-green-500/20 backdrop-blur-md rounded-2xl p-8 border border-blue-500/30 mb-8">
          <div class="flex justify-between items-start mb-6">
            <div>
              <span class="text-xs px-3 py-1 bg-green-500/20 text-green-400 rounded-full mb-2 inline-block">Plan actif</span>
              <h2 class="text-3xl font-bold mb-2">{{ activePlan.name }}</h2>
              <p class="text-gray-400">Objectif: {{ activePlan.goal }}</p>
            </div>
            <div class="text-right">
              <div class="text-4xl font-bold text-blue-400">{{ activePlan.calories }}</div>
              <div class="text-sm text-gray-400">calories/jour</div>
            </div>
          </div>
          
          <div class="grid grid-cols-3 gap-4 mb-6">
            <div class="bg-gray-900/60 rounded-xl p-4">
              <div class="flex justify-between mb-2">
                <span class="text-gray-400">Protéines</span>
                <span class="text-blue-400 font-bold">{{ activePlan.proteins }}g</span>
              </div>
              <div class="h-2 bg-gray-700 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" [style.width]="(activePlan.proteins / 200) * 100 + '%'"></div>
              </div>
            </div>
            <div class="bg-gray-900/60 rounded-xl p-4">
              <div class="flex justify-between mb-2">
                <span class="text-gray-400">Glucides</span>
                <span class="text-green-400 font-bold">{{ activePlan.carbs }}g</span>
              </div>
              <div class="h-2 bg-gray-700 rounded-full overflow-hidden">
                <div class="h-full bg-green-500 rounded-full" [style.width]="(activePlan.carbs / 400) * 100 + '%'"></div>
              </div>
            </div>
            <div class="bg-gray-900/60 rounded-xl p-4">
              <div class="flex justify-between mb-2">
                <span class="text-gray-400">Lipides</span>
                <span class="text-yellow-400 font-bold">{{ activePlan.fats }}g</span>
              </div>
              <div class="h-2 bg-gray-700 rounded-full overflow-hidden">
                <div class="h-full bg-yellow-500 rounded-full" [style.width]="(activePlan.fats / 100) * 100 + '%'"></div>
              </div>
            </div>
          </div>
          
          <div class="mb-6">
            <div class="flex justify-between text-sm mb-2">
              <span class="text-gray-400">Progression du plan</span>
              <span class="text-blue-400">{{ activePlan.progress }}%</span>
            </div>
            <div class="h-3 bg-gray-700 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-blue-500 to-green-400 rounded-full" 
                   [style.width]="activePlan.progress + '%'"></div>
            </div>
          </div>
          
          <div class="flex justify-between text-sm text-gray-400">
            <span>Début: {{ activePlan.startDate | date:'dd/MM/yyyy' }}</span>
            <span *ngIf="activePlan.endDate">Fin: {{ activePlan.endDate | date:'dd/MM/yyyy' }}</span>
          </div>
        </div>

        <!-- Liste des plans -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div *ngFor="let plan of dietPlans" class="bg-gray-800/40 backdrop-blur-md rounded-2xl p-6 border border-gray-700/50 hover:border-blue-500/50 transition" [class.border-blue-500/50]="plan.isActive">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-semibold">{{ plan.name }}</h3>
                <p class="text-sm text-gray-400">Objectif: {{ plan.goal }}</p>
              </div>
              <span *ngIf="plan.isActive" class="text-xs px-3 py-1 bg-green-500/20 text-green-400 rounded-full">
                Actif
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div>
                <div class="text-sm text-gray-400">Calories</div>
                <div class="text-xl font-bold text-blue-400">{{ plan.calories }} kcal</div>
              </div>
              <div>
                <div class="text-sm text-gray-400">Repas/jour</div>
                <div class="text-xl font-bold text-purple-400">{{ plan.mealsPerDay }}</div>
              </div>
              <div>
                <div class="text-sm text-gray-400">Eau</div>
                <div class="text-xl font-bold text-cyan-400">{{ plan.waterIntake }} L</div>
              </div>
              <div>
                <div class="text-sm text-gray-400">Progrès</div>
                <div class="text-xl font-bold text-green-400">{{ plan.progress }}%</div>
              </div>
            </div>
            
            <div class="space-y-2 mb-4">
              <div class="flex items-center space-x-2">
                <span class="text-xs w-16 text-gray-400">Protéines</span>
                <div class="flex-1 h-1.5 bg-gray-700 rounded-full overflow-hidden">
                  <div class="h-full bg-blue-500 rounded-full" [style.width]="(plan.proteins / 200) * 100 + '%'"></div>
                </div>
                <span class="text-xs text-blue-400">{{ plan.proteins }}g</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-xs w-16 text-gray-400">Glucides</span>
                <div class="flex-1 h-1.5 bg-gray-700 rounded-full overflow-hidden">
                  <div class="h-full bg-green-500 rounded-full" [style.width]="(plan.carbs / 400) * 100 + '%'"></div>
                </div>
                <span class="text-xs text-green-400">{{ plan.carbs }}g</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-xs w-16 text-gray-400">Lipides</span>
                <div class="flex-1 h-1.5 bg-gray-700 rounded-full overflow-hidden">
                  <div class="h-full bg-yellow-500 rounded-full" [style.width]="(plan.fats / 100) * 100 + '%'"></div>
                </div>
                <span class="text-xs text-yellow-400">{{ plan.fats }}g</span>
              </div>
            </div>
            
            <div class="flex space-x-2">
              <button *ngIf="!plan.isActive" (click)="activatePlan(plan.id)"
                      class="flex-1 px-3 py-2 bg-green-500/20 text-green-400 rounded-lg text-sm hover:bg-green-500/30 transition">
                <i class="fas fa-play mr-1"></i>Activer
              </button>
              <button (click)="editPlan(plan)"
                      class="flex-1 px-3 py-2 bg-yellow-500/20 text-yellow-400 rounded-lg text-sm hover:bg-yellow-500/30 transition">
                <i class="fas fa-edit mr-1"></i>Modifier
              </button>
              <button (click)="deletePlan(plan.id)"
                      class="px-3 py-2 bg-red-500/20 text-red-400 rounded-lg text-sm hover:bg-red-500/30 transition">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Modal de création/édition -->
        <div *ngIf="showModal" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4">
          <div class="bg-gray-800 rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
            <div class="p-6">
              <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold">{{ editingPlan ? 'Modifier' : 'Nouveau' }} plan alimentaire</h2>
                <button (click)="closeModal()" class="text-gray-400 hover:text-white text-xl">✕</button>
              </div>
              
              <form [formGroup]="planForm" (ngSubmit)="savePlan()">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div class="md:col-span-2">
                    <label class="block text-sm text-gray-400 mb-2">Nom du plan</label>
                    <input type="text" formControlName="name" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Objectif</label>
                    <select formControlName="goal" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                      <option value="prise de masse">Prise de masse</option>
                      <option value="perte de poids">Perte de poids</option>
                      <option value="maintenance">Maintenance</option>
                      <option value="performance">Performance</option>
                    </select>
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Calories/jour</label>
                    <input type="number" formControlName="calories" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Protéines (g)</label>
                    <input type="number" formControlName="proteins" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Glucides (g)</label>
                    <input type="number" formControlName="carbs" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Lipides (g)</label>
                    <input type="number" formControlName="fats" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Repas/jour</label>
                    <input type="number" formControlName="mealsPerDay" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Eau (L)</label>
                    <input type="number" formControlName="waterIntake" step="0.1" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Date de début</label>
                    <input type="date" formControlName="startDate" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                  
                  <div>
                    <label class="block text-sm text-gray-400 mb-2">Date de fin</label>
                    <input type="date" formControlName="endDate" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-3">
                  </div>
                </div>
                
                <div class="flex space-x-3">
                  <button type="submit" [disabled]="!planForm.valid"
                          class="flex-1 bg-blue-500 text-white py-3 rounded-lg hover:bg-blue-600 disabled:opacity-50">
                    {{ editingPlan ? 'Mettre à jour' : 'Créer' }}
                  </button>
                  <button type="button" (click)="closeModal()"
                          class="flex-1 bg-gray-700 text-white py-3 rounded-lg hover:bg-gray-600">
                    Annuler
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  `
})
export class HealthDietPlansComponent implements OnInit {
  private healthService = inject(HealthService);
  private fb = inject(FormBuilder);
  
  dietPlans: DietPlan[] = [];
  activePlan: DietPlan | null = null;
  
  showModal = false;
  editingPlan: DietPlan | null = null;
  
  planForm: FormGroup = this.fb.group({
    name: ['', Validators.required],
    goal: ['maintenance', Validators.required],
    calories: [2000, Validators.required],
    proteins: [100, Validators.required],
    carbs: [200, Validators.required],
    fats: [70, Validators.required],
    mealsPerDay: [3, Validators.required],
    waterIntake: [2, Validators.required],
    startDate: ['', Validators.required],
    endDate: ['']
  });

  ngOnInit() {
    this.loadPlans();
  }

  private loadPlans() {
    this.healthService.getActiveDietPlan().subscribe(plan => {
      this.activePlan = plan;
    });
  }

  openCreateModal() {
    this.editingPlan = null;
    this.planForm.reset({
      goal: 'maintenance',
      calories: 2000,
      proteins: 100,
      carbs: 200,
      fats: 70,
      mealsPerDay: 3,
      waterIntake: 2
    });
    this.showModal = true;
  }

  editPlan(plan: DietPlan) {
    this.editingPlan = plan;
    this.planForm.patchValue({
      name: plan.name,
      goal: plan.goal,
      calories: plan.calories,
      proteins: plan.proteins,
      carbs: plan.carbs,
      fats: plan.fats,
      mealsPerDay: plan.mealsPerDay,
      waterIntake: plan.waterIntake,
      startDate: new Date(plan.startDate).toISOString().split('T')[0],
      endDate: plan.endDate ? new Date(plan.endDate).toISOString().split('T')[0] : ''
    });
    this.showModal = true;
  }

  closeModal() {
    this.showModal = false;
    this.editingPlan = null;
  }

  savePlan() {
    if (this.planForm.valid) {
      const planData = {
        ...this.planForm.value,
        userId: '1',
        progress: 0,
        isActive: false
      };
      
      if (this.editingPlan) {
        this.healthService.updateDietPlan(this.editingPlan.id, planData).subscribe(() => {
          this.loadPlans();
          this.closeModal();
        });
      } else {
        this.healthService.createDietPlan(planData).subscribe(() => {
          this.loadPlans();
          this.closeModal();
        });
      }
    }
  }

  activatePlan(id: string) {
    this.healthService.updateDietPlan(id, { isActive: true }).subscribe(() => {
      this.loadPlans();
    });
  }

  deletePlan(id: string) {
    if (confirm('Êtes-vous sûr de vouloir supprimer ce plan ?')) {
      // Note: Ajoutez une méthode deleteDietPlan dans le service
    }
  }
}
